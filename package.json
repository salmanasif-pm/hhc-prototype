{
  "name": "hhc-operations-platform-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Home Health Compass Operations Platform - interactive Phase 1 prototype (office staff + clinician experiences, shared demo data).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
